COMPOSE_PROJECT_NAME=craig-meeting-e2e
CRAIG_IMAGE=craig-meeting-gateway:local

# Public Discord application ID. This is not the bot token.
DISCORD_APPLICATION_ID=000000000000000000

# The Meeting Platform service must have this DNS name on MEETING_NETWORK_NAME.
MEETING_INTEGRATION_URL=http://meeting-platform:4310
MEETING_NETWORK_NAME=discord-meeting-internal
CRAIG_DATA_ROOT=/mnt/volume_ams3_1784742570542/discord-meeting-assistant/data/craig
CRAIG_SECRETS_DIR=/mnt/volume_ams3_1784742570542/discord-meeting-assistant/secrets/craig

POSTGRES_DB=craig_meeting
POSTGRES_USER=craig_meeting
MEETING_AUTO_RECORD_CHANNEL_IDS=1533228823045214398
MEETING_AUTO_RECORD_SYNTHETIC_BOT_IDS=1533227577286852649,1533228054724346087
MEETING_AUTO_RECORD_START_DELAY_MS=500
MEETING_AUTO_RECORD_EMPTY_GRACE_MS=5000

MEETING_MAX_QUEUED_PACKETS=8192
MEETING_PACKET_BATCH_SIZE=128
MEETING_REQUEST_TIMEOUT_MS=5000
REDIS_KEY_PREFIX=craig-meeting:
CRAIG_LOG_LEVEL=info
